# -----------------------------------------------------------------------------
#  tablelisting — Supabase connection
#
#  Leave BOTH unset (or omit this file entirely) to run the app in local mode:
#  everything is stored in browser localStorage, seeded with sample rows.
#  Copy to `.env.local` and fill in to connect Supabase.
# -----------------------------------------------------------------------------

# Project URL from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=

# Client key. `NEXT_PUBLIC_SUPABASE_ANON_KEY` is the classic name and wins if
# both are set; `NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY` is what newer Supabase
# dashboards call it, and is accepted as a fallback.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
